# Normalize line endings: this plugin ships cross-platform and bundles scripts.
* text=auto eol=lf

# Scripts must stay LF (they run on macOS/Linux and via Git Bash on Windows).
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
