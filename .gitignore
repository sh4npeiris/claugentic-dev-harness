# ── Claude Code harness ────────────────────────────────────────────────────
# Share the harness itself (roles, plans, hooks); ignore only local overrides.
.claude/*
!.claude/agents/
!.claude/plans/
!.claude/settings.json
# This repo's OWN doc-budget caps. It MUST stay tracked: the doc-budget gate is a no-op
# when the config is absent, so an ignored config would silently disarm the gate in CI.
!.claude/claugentic-doc-budgets.json
.claude/settings.local.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
/dist/
/build/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Logs / local junk ──────────────────────────────────────────────────────────
*.log
*.tmp

# ── QA runtime-verification artifacts (engine/qa.js writes screenshots here) ──
.qa-artifacts/
.playwright-mcp/
eval/.runtime-qa/
